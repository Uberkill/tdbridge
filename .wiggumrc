{
  "project_name": "TDBridge",
  "source_dirs": [
    "src"
  ],
  "test_command": "npm test",
  "parser_type": "generic_zero",
  "timeout_seconds": 120,
  "max_iterations": 3,
  "failure_budget": 0,
  "ledger_file": "TASK_LEDGER.md",
  "state_file": "task_state.json",
  "auto_stash": true,
  "clean_untracked_on_rollback": true,
  "purge_caches_on_rollback": true,
  "is_monorepo": false,
  "workspace_packages": []
}